{
  "name": "dsh-claw-registry",
  "version": "0.3.0-rc.1",
  "description": "Claw agent registry for DeepSeek Harness: create agents, supply their wa-* agent presets, start and bind Claw sessions. Does not gate tools. Claw Agent 登记：新建 Agent、供给 wa-* 预设、开会话并绑定，不拦截工具。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "workspace"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./presets": "./registry-presets.mjs"
  },
  "files": [
    "host.js",
    "client.js",
    "registry-presets.mjs",
    "registry-preset-supply.mjs",
    "registry-store.mjs",
    "registry-claw.mjs",
    "registry-seeds.mjs",
    "registry-logic.mjs",
    "registry-i18n.mjs",
    "registry-styles.mjs",
    "registry-marks.mjs",
    "assets/claw-mark.png",
    "assets/claw-mark-open.png",
    "registry-view.mjs",
    "registry-observe.mjs",
    "registry-settings.mjs",
    "registry-template.mjs",
    "registry-navigation.mjs",
    "registry-bindings.mjs",
    "registry-claw-browser.mjs",
    "registry-browser-mode.mjs",
    "registry-compat-panel.mjs",
    "registry-session-mark.mjs",
    "registry-client-apply.mjs",
    "registry-runtime.mjs",
    "registry-migrate.mjs",
    "registry-leave.mjs",
    "registry-model.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "test": "npm run build:check && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "dsh-claw-core": "0.3.0-rc.1",
    "dsh-claw-policy": "0.3.0-rc.1",
    "dsh-claw-observability": "0.3.0-rc.1",
    "js-yaml": "^4.1.0"
  }
}
